# Configuración del Asistente Virtual Hacki
# Obtené tu clave gratuita de Groq en: https://console.groq.com/keys
IA_KEY=

# Endpoint compatible con OpenAI (por defecto Groq):
IA_URL=https://api.groq.com/openai/v1/chat/completions

# Modelo recomendado (rápido y gratuito):
IA_MODELO=llama-3.3-70b-versatile,openai/gpt-oss-20b,llama-3.1-8b-instant

# Clave opcional para el panel de auditoría de preguntas (/api/preguntas):
ADMIN_KEY=clave_admin_secreta

# Límites de consultas:
LIMITE_IP_HORA=30
LIMITE_DIA=500
